{
  "name": "renderball",
  "version": "0.0.1",
  "description": "Renderball — script-first AI video generation",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "type-check": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "usage": "node scripts/usage-report.mjs",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "postinstall": "playwright install chromium || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.99.0",
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@clerk/nextjs": "^6.39.5",
    "@prisma/client": "^6.19.3",
    "@remotion/bundler": "4.0.468",
    "@remotion/lottie": "^4.0.468",
    "@remotion/renderer": "4.0.468",
    "clsx": "2.1.1",
    "esbuild": "0.28.0",
    "lucide-react": "^1.17.0",
    "next": "^14.2.35",
    "playwright": "^1.60.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.8.1",
    "remotion": "4.0.468",
    "sharp": "^0.33.5",
    "shiki": "^4.1.0",
    "simple-icons": "^16.21.0",
    "tailwind-merge": "2.5.4",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/node": "22.5.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "dotenv-cli": "^11.0.0",
    "postcss": "8.4.47",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4.14",
    "typescript": "5.5.4"
  }
}
