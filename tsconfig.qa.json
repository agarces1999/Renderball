{
  // The QA suite is real TypeScript that NOTHING was type-checking.
  //
  // tsconfig.json's `include` covers src/app/lib/components — deliberately, so
  // `next build` does not compile Playwright flows into the product — but the
  // consequence went unnoticed: `npx tsc --noEmit` returned clean for edits to
  // qa/ that it had never read. The runner's esbuild bundle catches syntax and
  // nothing else, so a type error in a flow surfaced only as a confusing
  // failure at run time, if at all.
  //
  // This config exists to be run explicitly (npm run typecheck:qa) and in CI.
  "extends": "./tsconfig.json",
  // qa/ AND scripts/ — between this config and tsconfig.json, every directory
  // in the repo is now read by a type-checker. That is the point: the qa/ hole
  // existed because nothing was checking a directory, and an excluded
  // directory is the same hole with a comment on it. scripts/ carried 22
  // errors when this config was written; they were fixed (and eight superseded
  // one-off spikes deleted) rather than excluded. If a new script does not
  // type-check, fix the script.
  "include": ["qa/**/*", "lib/**/*", "src/**/*", "scripts/**/*.ts"],
  // qa/fixtures is the ONE exception, and it is the same exception as
  // src/generated directly above it: a committed copy of GENERATED DECK CODE,
  // not source. Its lego pieces are JSX fragments by design — a piece body is
  // spliced into a template, so it has no single parent element and cannot
  // type-check as a module. Excluding a directory of our own code would be the
  // hole this config was written to close; excluding a fixture of model output
  // is what src/generated already established.
  "exclude": ["node_modules", "out", "public/renders", "src/generated", "qa/fixtures"]
}
