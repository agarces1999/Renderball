// Renderball data model — the multi-tenant store that replaced .data/*.json.
//
// Status: LIVE (migrated on Neon; lib/store.ts defaults to the pg backend
// since 2026-07-08, RB_STORE_BACKEND=file is the escape hatch). Deploys run
// `prisma migrate deploy` on boot (Dockerfile CMD).
//
// Design choices:
//  - Every owned row carries ownerId; nothing is ever queried without it. This
//    is the fix for the audit's #1 blocker (listBriefs() returned all briefs).
//  - Brief + Script are kept as JSON columns on Project so we don't have to
//    re-model dozens of nested fields up front; we still index the hot lookups
//    (ownerId, scriptId).
//  - User.clerkId is the bridge to Clerk; a Clerk webhook upserts User rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  subscription
}

enum ProjectStatus {
  awaiting_agent_1
  script_generated
  script_approved
  rendering
  rendered
  failed
}

enum RenderStatus {
  queued
  rendering
  complete
  failed
}

model User {
  id               String   @id @default(cuid())
  clerkId          String   @unique // subject id from Clerk
  email            String   @unique
  stripeCustomerId String?  @unique
  /// Lemon Squeezy's customer id. Separate column rather than a renamed one:
  /// the two processors' id spaces are unrelated, and a single column would
  /// make "which processor is this account on?" unanswerable.
  lemonCustomerId  String?  @unique
  plan             Plan     @default(free)
  freeMinuteUsed   Boolean  @default(false) // the "free first minute" gate
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projects      Project[]
  renders       Render[]
  usageRecords  UsageRecord[]
  subscription  Subscription?
  tokenUsage    TokenUsage?
  brandKits     BrandKit[]
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which processor owns this subscription. Lemon Squeezy is the live path
  /// (founder call); the Stripe columns below stay for the dormant one — see
  /// lib/billing-provider.ts.
  provider String @default("stripe")

  stripeSubscriptionId String? @unique
  stripePriceId        String?

  lemonSubscriptionId String? @unique
  /// The subscription ITEM, not the subscription. Lemon Squeezy attaches usage
  /// records to an item, so without this id metered billing cannot report a
  /// single token — it is the one field the whole pricing model hangs on.
  lemonItemId         String?

  status           String // active, past_due, cancelled, expired, ...
  currentPeriodEnd DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Project {
  id           String        @id // ULID, preserved from the current store
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purpose      String
  status       ProjectStatus @default(awaiting_agent_1)
  brief        Json          // StoredBrief
  script       Json?         // Script (set after Agent 1)
  brandExtract Json?         // BrandExtract cache
  scriptId     String?       @unique
  error        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  /// Public share link. NULL means the document is private, which is the
  /// default and the state every existing document starts in. The token is the
  /// entire credential for read-only access, so it is generated from 32 random
  /// bytes rather than derived from the document id — knowing a scriptId must
  /// never be enough to read someone's deck. Revoking is setting this back to
  /// NULL, which takes effect on the next request.
  shareToken   String?       @unique
  sharedAt     DateTime?

  renders Render[]

  @@index([ownerId])
  @@index([ownerId, createdAt])
}

model Render {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status          RenderStatus @default(queued)
  resolution      String       @default("1080p")
  durationSeconds Float?
  costUsd         Float?       // billable cost of this render
  outputUrl       String?      // object-storage URL of the final MP4
  lambdaRenderId  String?      // Remotion Lambda render id, for progress polling
  createdAt       DateTime     @default(now())
  completedAt     DateTime?

  @@index([ownerId])
  @@index([projectId])
}

// Per-operation cost ledger — the persisted, user-attributed form of
// lib/usage.ts's UsageRecord (which today is an anonymous JSONL append).
model UsageRecord {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId    String?
  operation    String   // crawl | script | build | render | ...
  model        String
  costUsd      Float
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cacheRead    Int      @default(0)
  cacheWrite   Int      @default(0)
  failed       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([ownerId, createdAt])
}

// Per-user LIFETIME LLM token counter — the canvas pivot's usage-based pricing
// unit (docs/METERING.md). One row per user, atomically incremented from every
// LLM call site; deterministic edits never touch it. The 1M free allowance is
// enforced against totalTokens app-side; Stripe only ever sees overage.
// BigInt: a heavy account crosses Int4's 2.1B within normal product life.
/// One LLM-spending editor operation, for the per-owner hourly brake.
///
/// A row per op rather than a counter, because the window slides: "30 in the
/// last hour" needs to know WHEN, and a counter would either reset on the hour
/// (letting someone burst 60 across the boundary) or need a second column to
/// track the reset. Rows are pruned as they age out.
///
/// It lives in Postgres because the in-process version it replaces reset on
/// every deploy — which, shipping several times a day, meant the brake was
/// mostly off — and could not see a second container.
model OpWindow {
  id      String   @id @default(cuid())
  ownerId String
  op      String
  at      DateTime @default(now())

  @@index([ownerId, op, at])
  @@index([at])
}

/// PROVIDER SPEND — what WE owe Fireworks, one row per paid provider call.
///
/// Written from inside the four paid transports (castCall, callZaiVision,
/// callZaiText, imageCall), never from a route. The reason is a measured one:
/// in August 2026 Fireworks' dashboard said $37.69 and our records covered
/// $6.52. recordUsage() was not missing — it had eight call sites — but
/// recording was a PER-CALL-SITE CONVENTION, so every surface written after
/// the convention (the production outline route, the image-attachment OCR,
/// suggest-layout, ~12 offline scripts, and an esbuild lab bundle that ran
/// ~180 paid generations over two days) simply never opted in. A transport
/// cannot forget.
///
/// WHY POSTGRES AND NOT .data/usage.jsonl: `.dockerignore` excludes .data from
/// the image, Railway's disk is ephemeral, and a volume attaches to ONE
/// instance — so a file ledger is lost on deploy and split-brain the moment a
/// second replica runs. The same reasoning already moved decks to R2
/// (lib/render/gen-store.ts) and briefs to pg (lib/store.ts). "An exact number
/// always" cannot live on a disk that gets thrown away.
///
/// WHY A NEW TABLE and not UsageRecord: UsageRecord's ROW GRAIN is the paywall
/// — lib/entitlement.ts counts its rows against FREE_BUILDS_PER_MONTH. One row
/// per LLM call in there would turn "3 free builds" into "3 free LLM calls".
/// TokenUsage answers the opposite question (what the USER owes US) and
/// deliberately skips DEV_OWNER_ID and cached tokens. Both are right for their
/// job and wrong for this one. They share the pricing function
/// (lib/usage.ts costUsd), not the table.
model SpendRecord {
  id String @id @default(cuid())

  at DateTime @default(now())

  provider String @default("fireworks")
  /// The WIRE model id verbatim ("accounts/fireworks/routers/glm-5p2-fast"),
  /// because that is what the provider bills. A routing change then shows up
  /// in the next query instead of hiding behind an abstract name.
  model    String
  /// Which part of the product spent this: "outline" | "build" | "vision" |
  /// "crawl" | "edit.insert" | "edit.regen" | "image" | "unattributed".
  /// A missing label NEVER loses the row — it lands as "unattributed", which
  /// is itself the signal that an entrypoint still needs wiring.
  stage    String  @default("unattributed")

  /// Verbatim from the completion response. Never derived, never estimated.
  inputTokens  Int @default(0) // prompt_tokens
  outputTokens Int @default(0) // completion_tokens
  /// prompt_tokens_details.cached_tokens when the wire reports it. RECORDED
  /// BUT NOT DISCOUNTED: Fireworks' cached-input semantics are unverified on
  /// this account (no invoice yet), so cost prices the full prompt at the base
  /// rate — lib/usage.ts's standing posture of overstating, never under.
  /// Storing the count means history can be re-priced from the first real
  /// invoice instead of guessed at.
  cachedTokens Int @default(0)
  /// Per-IMAGE billed ops (SDXL in the editor) carry no tokens at all.
  images       Int @default(0)

  /// Decimal, not Float, deliberately breaking this schema's own convention:
  /// the requirement is literally "an exact number always", and Postgres
  /// SUM(numeric) is exact where SUM(double precision) accumulates error.
  costUsd     Decimal @db.Decimal(14, 8)
  /// Which RATES table priced this row. lib/usage.ts admits its Kimi rate is
  /// an estimate and its image rates are rounded up; without this, correcting
  /// a rate either silently rewrites reported history or is impossible.
  rateVersion String

  /// NULLABLE and deliberately NOT a User relation (same shape as OpWindow):
  /// offline scripts and the dev loop have no owner, and that spend is still
  /// real money. A foreign key would reject exactly the rows that went missing.
  ownerId   String?
  scriptId  String?
  /// Groups every call of one build attempt, for cost-per-deck.
  runId     String?

  /// false = we paid (or may have) and got nothing usable.
  ok            Boolean @default(true)
  /// The provider may have billed but reported no usage we could read — a
  /// timeout or abort mid-generation. Tokens stay ZERO and cost stays ZERO;
  /// this flag plus latencyMs is the honest floor. Same discipline as
  /// lib/agents/pipeline.ts:485 — never a fabricated estimate.
  tokensUnknown Boolean @default(false)
  latencyMs     Int?

  /// "web" | "script" | "test". Offline lab spend was the MAJORITY of August;
  /// unit economics are meaningless if it cannot be separated from customers'.
  origin String @default("web")

  @@index([at])
  @@index([stage, at])
  @@index([model, at])
  @@index([scriptId])
  @@index([ownerId, at])
}

model TokenUsage {
  ownerId      String   @id
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  totalTokens  BigInt   @default(0) // lifetime counted tokens (input + output)
  billedTokens BigInt   @default(0) // overage tokens already handed to the outbox

  /// Tokens that did not add up to a whole billing unit yet.
  ///
  /// A processor bills in integer quantities. If the unit is 1,000 tokens
  /// (RB_METER_UNIT_TOKENS) then an outbox row of 1,500 reports 1 unit and
  /// leaves 500 here to join the next one. Without this, every partial unit
  /// would be rounded away — a steady, invisible undercharge on exactly the
  /// small frequent operations the product is built around.
  remainderTokens Int   @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Durable outbox for Stripe Billing Meter events. Ops append billable deltas
// here transactionally and a best-effort flusher reports them to Stripe with
// `identifier = id` (Stripe dedupes identifiers → at-least-once flush is safe).
// An op NEVER blocks on Stripe availability; unsent rows retry on later ops.
model MeterEventOutbox {
  id        String    @id @default(cuid())
  ownerId   String
  tokens    Int // billable tokens of one op (an op's delta always fits Int4)
  status    String    @default("pending") // pending | sent
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@index([ownerId])
}

// Anti-abuse ledger for the no-watermark free tier (PRODUCT.md §825-877).
model FreeTierSignup {
  id          String   @id @default(cuid())
  email       String
  ip          String?
  fingerprint String?
  userId      String?
  convertedToPaid Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([ip])
  @@index([fingerprint])
}

// Saved brand kit (canvas pivot, docs/PIVOT.md NEW #5): the crawl's
// BrandExtract promoted from a per-brief cache (StoredBrief.brand_extract)
// to an account-level entity reusable across documents. One kit per
// (owner, host); a re-crawl refreshes `extract` in place, and the user's
// overrides only change when the user re-locks them (see lib/brand-kits.ts).
model BrandKit {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  url          String   // normalized host, e.g. "acme.com" (the full crawl URL lives in extract.url)
  extract      Json     // BrandExtract (app/new/schema.ts) — shape identical to StoredBrief.brand_extract
  paletteRoles Json?    // user override: { primary?, accent?, light?, dark? } hex roles
  logoSource   String?  // user override: "upload" | "crawl_confirmed" — how the logo was locked
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerId, url])
  @@index([ownerId, updatedAt])
}

// Script JSON bytes, keyed by script ULID. Separate from Project.script
// because the write ORDER is decoupled in the product flow: submitBrief
// saves the script FIRST, then updates the brief/Project with script_id —
// so saveScript(script) has nothing to join on at initial-save time.
// Ownership is still resolved exclusively through Project.scriptId (indexed,
// unique); ScriptDoc is never queried without that ownership hop.
model ScriptDoc {
  id        String   @id // script ULID
  json      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
