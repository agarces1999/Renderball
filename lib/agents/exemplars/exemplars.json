  "code": "export const Section1: React.FC<{ script: Script }> = ({ script }) => {\n  const c = script.scenes[1].content;\n  return (\n    <div style={{ ...SECTION_FRAME, background: PALETTE.bg, fontFamily: FONT_BODY }}>\n      <style dangerouslySetInnerHTML={{ __html: BRAND_FONTS_CSS + KEYFRAMES_CSS }} />\n      <Piece id=\"s1.atmos\" kind=\"atmosphere\">\n        <div style={{ position: \"absolute\", left: \"50%\", top: 680, width: 800, height: 800, marginTop: -400, marginLeft: -400, borderRadius: \"50%\", background: `radial-gradient(circle at 50% 50%, ${PALETTE.dark} 0%, transparent 60%)`, opacity: 0.07, filter: \"blur(40px)\", animation: \"glowBreathe 4s ease-in-out infinite\", pointerEvents: \"none\" }} />\n        <DustField opacity={0.6} />\n        <div style={{ position: \"absolute\", left: 120, top: 440, width: 280, height: 1, background: PALETTE.hairline, opacity: 0.5 }} />\n        <div style={{ position: \"absolute\", left: 120, top: 452, fontFamily: FONT_MONO, fontSize: 12, letterSpacing: \"0.15em\", textTransform: \"uppercase\", color: PALETTE.muted, opacity: 0.7 }}>Voice output</div>\n      </Piece>\n      <Piece id=\"s1.copy\" kind=\"text\">\n        <div style={{ position: \"absolute\", top: 120, left: 120, width: 680, display: \"flex\", flexDirection: \"column\", gap: 28 }}>\n          <Eyebrow text={c.eyebrow} style={{ opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 0s forwards\", animationDelay: \"0s\" }} />\n          <h1 data-content-path=\"headline\" style={{ fontFamily: FONT_DISPLAY, fontWeight: 700, fontSize: 120, lineHeight: 1.0, letterSpacing: \"-0.035em\", color: PALETTE.ink, margin: 0, opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 0.1s forwards\", animationDelay: \"0.1s\" }}>{c.headline}</h1>\n          <p data-content-path=\"lede\" style={{ fontFamily: FONT_BODY, fontSize: 24, lineHeight: 1.5, color: PALETTE.dark, [\"--fade-to\" as any]: \"0.85\", opacity: 0, margin: 0, maxWidth: 540, animation: \"fadeRiseTo 0.3s ease-out 0.3s forwards\", animationDelay: \"0.3s\" }}>{c.lede}</p>\n        </div>\n        {c.meta?.length ? (\n          <div style={{ position: \"absolute\", bottom: 100, left: 120, right: 120, display: \"flex\", gap: 80, borderTop: `1px solid ${PALETTE.hairline}`, paddingTop: 22, opacity: 0, animation: \"fadeRise 0.5s ease-out 3.8s forwards\", animationDelay: \"3.8s\" }}>\n            <div>\n              <div data-content-path=\"meta.0.label\" style={{ fontSize: 12, letterSpacing: \"0.2em\", textTransform: \"uppercase\", color: PALETTE.muted, fontFamily: FONT_BODY }}>{c.meta[0].label}</div>\n              <div data-content-path=\"meta.0.value\" style={{ fontSize: 32, fontWeight: 700, color: PALETTE.ink, fontFamily: FONT_DISPLAY, marginTop: 6, lineHeight: 1, letterSpacing: \"-0.02em\" }}>{c.meta[0].value}</div>\n            </div>\n            <div>\n              <div data-content-path=\"meta.1.label\" style={{ fontSize: 12, letterSpacing: \"0.2em\", textTransform: \"uppercase\", color: PALETTE.muted, fontFamily: FONT_BODY }}>{c.meta[1].label}</div>\n              <div data-content-path=\"meta.1.value\" style={{ fontSize: 32, fontWeight: 700, color: PALETTE.ink, fontFamily: FONT_DISPLAY, marginTop: 6, lineHeight: 1, letterSpacing: \"-0.02em\" }}>{c.meta[1].value}</div>\n            </div>\n          </div>\n        ) : null}\n      </Piece>\n      <Piece id=\"s1.waveform\" kind=\"diegetic\" throughline=\"waveform\">\n        <div style={{ position: \"absolute\", left: \"50%\", top: 560, width: 1200, height: 400, marginLeft: -600, marginTop: -200, borderRadius: \"50%\", background: `radial-gradient(circle at 50% 50%, ${PALETTE.dark} 0%, transparent 60%)`, opacity: 0, filter: \"blur(60px)\", animation: \"glowIntensify 1s ease-out 4.5s forwards\", animationDelay: \"4.5s\", pointerEvents: \"none\" }} />\n        <div data-throughline=\"waveform\" style={{ position: \"absolute\", left: \"50%\", top: 560, transform: \"translateX(-50%)\", display: \"flex\", flexDirection: \"column\", alignItems: \"center\", gap: 32 }}>\n          <div style={{ position: \"relative\" }}>\n            <WaveformStrip barCount={60} amplitude={2.5} color={PALETTE.ink} width={1200} barWidth={5} riseStart={0.3} riseStagger={0.02} riseDuration={0.6} />\n            <div style={{ position: \"absolute\", inset: 0, overflow: \"hidden\", pointerEvents: \"none\" }}>\n              <div style={{ position: \"absolute\", top: 0, left: 0, width: \"30%\", height: \"100%\", background: \"linear-gradient(90deg, transparent, rgba(245,243,241,0.12), transparent)\", animation: \"sweep 1.2s ease-in-out 4s\" }} />\n            </div>\n          </div>\n          {c.caption && (\n            <div data-content-path=\"caption\" style={{ fontFamily: FONT_MONO, fontSize: 14, letterSpacing: \"0.06em\", color: PALETTE.muted, display: \"inline-flex\", alignItems: \"center\", gap: 6, clipPath: \"inset(0 100% 0 0)\", animation: \"typeReveal 0.8s steps(25, end) 2.2s forwards\", animationDelay: \"2.2s\" }}>\n              {c.caption}\n              <span style={{ display: \"inline-block\", width: 8, height: 16, background: PALETTE.ink, animation: \"caretBlink 1s steps(2, end) 3s infinite\" }} />\n            </div>\n          )}\n          <div style={{ width: 0, height: 1, background: PALETTE.hairline, opacity: 0, animation: \"accentExtend 0.8s ease-out 3.8s forwards\", animationDelay: \"3.8s\" }} />\n        </div>\n      </Piece>\n      <Piece id=\"s1.chrome\" kind=\"chrome\"><Chrome sceneIndex={1} totalScenes={5} category=\"AI Voice Platform\" /></Piece>\n    </div>\n  );\n};"
 },
