[
 {
  "id": "stat-proof",
  "register": "stat",
  "notes": "Hero stat with supporting structure — big two-tone number, baseline rule, meta row; cleared the empty-band gate.",
  "code": "export const Section3: React.FC<{ script: Script }> = ({ script }) => {\n  const c = script.scenes[3].content;\n  const domains = [\"bell-labs.com\", \"history.com\", \"ieee.org\"];\n  const followups = [\"Who were the three inventors?\", \"How did the transistor change computing?\", \"When was the first silicon transistor built?\"];\n  return (\n    <div style={{ ...SECTION_FRAME, background: PALETTE.bgDeep, fontFamily: FONT_DISPLAY }}>\n      <style dangerouslySetInnerHTML={{ __html: SHARED_CSS + ANIMATIONS_CSS + S3_ANIM_CSS + `\n.s3-left ul > li:nth-child(1) { animation-delay: 1.2s; }\n.s3-left ul > li:nth-child(2) { animation-delay: 1.35s; }\n.s3-left ul > li:nth-child(3) { animation-delay: 1.5s; }\n` }} />\n\n      <Piece id=\"s3.atmos\" kind=\"atmosphere\">\n        <div style={{ position: \"absolute\", inset: 0, background: `linear-gradient(135deg, ${PALETTE.accent}14 0%, transparent 55%)`, animation: \"bgShift 8s ease-in-out infinite\" }} />\n        <div style={{ position: \"absolute\", left: 100, top: 220, width: 760, height: 520, borderRadius: \"50%\", background: `radial-gradient(circle, ${PALETTE.accent}24 0%, transparent 65%)`, animation: \"s3glowPulse 3s ease-in-out infinite\", pointerEvents: \"none\" }} />\n        <GrainOverlay />\n      </Piece>\n\n      {/* Left column — the stat + proof list */}\n      <Piece id=\"s3.copy\" kind=\"text\">\n        <div className=\"s3-left\" style={{ position: \"absolute\", left: 110, top: 150, width: 880 }}>\n          <div style={{ opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 0.2s forwards\" }}>\n            <Eyebrow>{c.eyebrow}</Eyebrow>\n          </div>\n          <h1 data-content-path=\"headline\" style={{ fontFamily: FONT_DISPLAY, fontWeight: 700, fontSize: 150, lineHeight: 1, letterSpacing: \"-0.045em\", color: PALETTE.accent, margin: \"24px 0 0\", display: \"flex\", alignItems: \"center\", gap: 18, opacity: 0, animation: \"scaleIn 0.5s cubic-bezier(.2,.9,.2,1) 0s forwards\" }}>\n            <Zap size={56} strokeWidth={2} color={PALETTE.accent} />\n            <span style={{ color: PALETTE.accent, animation: \"brightenTeal 0.6s ease-out 4.5s forwards, counterGlow 3s ease-in-out 0s infinite\" }}>{c.headline}</span>\n          </h1>\n          <div style={{ height: 3, width: 0, background: PALETTE.accent, borderRadius: 2, margin: \"30px 0 0\", [\"--target-w\" as any]: \"130px\", animation: \"drawWidth 0.9s cubic-bezier(.2,.8,.2,1) 2.3s forwards\" }} />\n          <p data-content-path=\"lede\" style={{ fontFamily: FONT_BODY, fontSize: 24, lineHeight: 1.5, color: PALETTE.lede, margin: \"26px 0 0\", maxWidth: 740, opacity: 0, animation: \"fadeRise 0.5s cubic-bezier(.2,.8,.2,1) 0.6s forwards\" }}>{c.lede}</p>\n          <Bullets items={c.bullets} />\n        </div>\n\n        <div style={{ position: \"absolute\", left: 110, bottom: 110, width: 600, opacity: 0, animation: \"fadeRise 0.5s cubic-bezier(.2,.8,.2,1) 1s forwards\" }}>\n          <div data-content-path=\"caption\" style={{ fontFamily: FONT_MONO, fontSize: 14, letterSpacing: \"0.1em\", textTransform: \"uppercase\", color: PALETTE.faint, marginBottom: 14 }}>{c.caption}</div>\n          <MetaRow items={c.meta} align=\"left\" />\n        </div>\n      </Piece>\n\n      {/* Source-domain chips — upper right */}\n      <Piece id=\"s3.chips\" kind=\"diegetic\">\n        <div className=\"s3-chips\" style={{ position: \"absolute\", right: 110, top: 175, display: \"flex\", gap: 10 }}>\n          {domains.map((d, i) => (\n            <Piece id={`s3.chips.${i}`} key={i} kind=\"card\"><DomainChip domain={d} /></Piece>\n          ))}\n        </div>\n      </Piece>\n\n      {/* Answer card fragment — throughline branches to a new question */}\n      <Piece id=\"s3.query\" kind=\"diegetic\">\n        <div data-throughline=\"query-string\" style={{ position: \"absolute\", right: 110, top: 250, width: 720, borderRadius: 18, background: \"rgba(255,255,255,0.035)\", border: `1px solid ${PALETTE.hairline}`, boxShadow: \"0 30px 80px rgba(0,0,0,0.45)\", padding: 28, boxSizing: \"border-box\", opacity: 0, animation: \"cardRise 0.6s cubic-bezier(.2,.8,.2,1) 2.5s forwards\" }}>\n          <div style={{ display: \"flex\", alignItems: \"center\", gap: 12, marginBottom: 18, opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 3s forwards\" }}>\n            <AnswerTag />\n            <span style={{ fontFamily: FONT_BODY, fontSize: 16, color: PALETTE.muted }}>{c.bullets?.[0]}</span>\n          </div>\n\n          <div className=\"s3-cites\" style={{ display: \"flex\", gap: 22, alignItems: \"flex-start\", marginBottom: 16 }}>\n            <div style={{ flex: 1, minWidth: 0, fontFamily: FONT_DISPLAY, fontSize: 23, lineHeight: 1.42, color: PALETTE.ink, fontWeight: 500 }}>\n              <span data-content-path=\"bullets.1\" style={{ opacity: 0, animation: \"fadeRise 0.5s cubic-bezier(.2,.8,.2,1) 3.4s forwards\" }}>{c.bullets?.[1]}</span>\n              <Cite n={1} /><Cite n={2} />\n            </div>\n            <div style={{ flexShrink: 0, width: 120, height: 96, borderRadius: 10, overflow: \"hidden\", border: `1px solid ${PALETTE.hairline}`, opacity: 0, animation: \"imgReveal 0.5s ease-out 3.6s forwards\" }}>\n              <Img src={TRANSISTOR_IMG} style={{ width: \"100%\", height: \"100%\", objectFit: \"cover\", display: \"block\" }} />\n            </div>\n          </div>\n\n          <div style={{ display: \"flex\", alignItems: \"center\", gap: 8, padding: \"11px 0\", borderTop: `1px solid ${PALETTE.hairline}`, borderBottom: `1px solid ${PALETTE.hairline}`, marginBottom: 18, opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 3.8s forwards\" }}>\n            <BadgeCheck size={18} strokeWidth={2} color={PALETTE.accent} />\n            <span style={{ fontFamily: FONT_BODY, fontSize: 14, color: PALETTE.muted }}>Verified across sources</span>\n          </div>\n\n          <div style={{ fontFamily: FONT_BODY, fontSize: 12, letterSpacing: \"0.16em\", textTransform: \"uppercase\", color: PALETTE.faint, marginBottom: 8, opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 4s forwards\" }}>Related questions</div>\n          {followups.map((q, i) => (\n            <div key={i} style={{ display: \"flex\", alignItems: \"center\", gap: 10, padding: \"8px 0\", fontFamily: FONT_BODY, fontSize: 15, color: \"rgba(255,255,255,0.82)\", opacity: 0, animation: `fadeRise 0.4s cubic-bezier(.2,.8,.2,1) ${4.1 + i * 0.12}s forwards` }}>\n              <Search size={14} strokeWidth={2} color={PALETTE.accent} />\n              {q}\n            </div>\n          ))}\n\n          <div style={{ display: \"flex\", alignItems: \"center\", gap: 12, marginTop: 16, height: 44, padding: \"0 16px\", borderRadius: 12, background: \"rgba(255,255,255,0.03)\", border: `1px solid ${PALETTE.hairline}`, opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 4.5s forwards\" }}>\n            <Search size={16} strokeWidth={2} color={PALETTE.accent} />\n            <span style={{ fontFamily: FONT_BODY, fontSize: 15, color: PALETTE.faint }}>Ask anything…</span>\n            <span style={{ marginLeft: \"auto\", display: \"inline-block\", width: 2, height: 18, background: PALETTE.accent, animation: \"caretBlink 1s step-end 4.5s infinite\" }} />\n          </div>\n        </div>\n      </Piece>\n\n      <Piece id=\"s3.chrome\" kind=\"chrome\"><Chrome sceneIndex={3} category=\"Answer Engine\" /></Piece>\n    </div>\n  );\n};"
 },
 {
  "id": "quote-manifesto",
  "register": "quote",
  "notes": "Manifesto pull-quote with aggressive display type + supporting texture; voice-forward brand.",
  "code": "export const Section1: React.FC<{ script: Script }> = ({ script }) => {\n  const c = script.scenes[1].content;\n  return (\n    <div style={{ ...SECTION_FRAME, background: PALETTE.black, fontFamily: FONT_BODY, color: PALETTE.light, animation: \"shake 0.15s ease-out 0s, shake 0.1s ease-out 1.2s\" }}>\n      <style dangerouslySetInnerHTML={{ __html: BRAND_FONTS_CSS + ANIMATIONS_CSS }} />\n\n      <Piece id=\"s1.atmos\" kind=\"atmosphere\">\n        <div style={{ position: \"absolute\", inset: 0, backgroundImage: \"repeating-linear-gradient(45deg, rgba(255,0,0,0.05) 0px, rgba(255,0,0,0.05) 40px, transparent 40px, transparent 80px)\", animation: \"hazardDrift 6s linear infinite\" }} />\n        <div style={{ position: \"absolute\", inset: 26, border: `1px solid ${PALETTE.green}`, opacity: 0, [\"--to-op\" as any]: 0.5, animation: \"fadeInTo 0.5s ease-out 0.3s forwards\", pointerEvents: \"none\" }} />\n        {[\n          { x: 11, y: 24, s: 6 },\n          { x: 87, y: 19, s: 5 },\n          { x: 77, y: 82, s: 7 },\n          { x: 17, y: 85, s: 5 },\n        ].map((d, i) => (\n          <div key={i} style={{ position: \"absolute\", left: `${d.x}%`, top: `${d.y}%`, width: d.s, height: d.s, borderRadius: \"50%\", background: PALETTE.red, boxShadow: \"0 0 14px rgba(255,0,0,0.6)\", [\"--dot-op\" as any]: 0.75, opacity: 0, animation: `dotEnter 0.4s ease-out ${0.3 + i * 0.25}s forwards, drift${(i % 3) + 1} ${4 + i}s ease-in-out 0s infinite` }} />\n        ))}\n        <GrainOverlay opacity={0.07} animStyle={{ animation: \"textureFlicker 3s ease-in-out infinite\" }} />\n      </Piece>\n\n      <Piece id=\"s1.throughline\" kind=\"diegetic\" throughline=\"tallboy-can\">\n        <div data-throughline=\"tallboy-can\" style={{ position: \"absolute\", left: THL.left, top: THL.top, opacity: 0, [\"--to-op\" as any]: 0.05, animation: \"fadeInTo 1s ease-out 0.5s forwards\" }}>\n          <TallboyCan variant=\"silhouette\" width={130} gid=\"s1\" />\n        </div>\n      </Piece>\n\n      <Piece id=\"s1.copy\" kind=\"text\">\n        <div style={{ position: \"absolute\", left: 80, top: 80, width: 1760, height: 920, display: \"flex\", flexDirection: \"column\", alignItems: \"center\", justifyContent: \"space-between\", textAlign: \"center\", boxSizing: \"border-box\", padding: \"36px 0\" }}>\n          <div style={{ display: \"flex\", flexDirection: \"column\", alignItems: \"center\", gap: 24 }}>\n            <div style={{ ...eyebrowStyle, opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 0.1s forwards\" }}>\n              <span style={{ width: 30, height: 1, background: PALETTE.green, opacity: 0.7, display: \"inline-block\" }} />\n              <span data-content-path=\"eyebrow\">{c.eyebrow}</span>\n            </div>\n            <h1 data-content-path=\"headline\" className=\"s1-headline\" style={{ ...headlineBase, fontSize: 112, lineHeight: 0.94, maxWidth: 1560, textTransform: \"uppercase\", opacity: 0, animation: \"scaleInHard 0.4s cubic-bezier(.2,.8,.2,1) 0s forwards\" }}>\n              {renderAccent(c.headline, 0, PALETTE.red, 2)}\n            </h1>\n            <p data-content-path=\"lede\" style={{ ...ledeStyle, maxWidth: 940, textAlign: \"center\", opacity: 0, [\"--to-op\" as any]: 0.86, animation: \"fadeRiseTo 0.5s cubic-bezier(.2,.8,.2,1) 0.7s forwards\" }}>{c.lede}</p>\n          </div>\n\n          <div style={{ display: \"flex\", flexDirection: \"column\", alignItems: \"center\", gap: 30, width: \"100%\", maxWidth: 1560 }}>\n            {c.bullets?.length ? (\n              <ul style={{ listStyle: \"none\", margin: 0, padding: 0, display: \"grid\", gridTemplateColumns: \"repeat(3, 1fr)\", gap: 22, width: \"100%\", boxSizing: \"border-box\" }}>\n                <li data-content-path=\"bullets.0\" style={{ listStyle: \"none\", padding: \"26px\", border: \"1px solid rgba(253,253,253,0.16)\", background: \"rgba(255,255,255,0.02)\", display: \"flex\", flexDirection: \"column\", gap: 16, textAlign: \"left\", boxSizing: \"border-box\", opacity: 0, animation: \"fadeRise 0.5s ease-out 1.4s forwards\" }}>\n                  <span style={{ fontFamily: FONT_DISPLAY, fontSize: 30, color: PALETTE.green, lineHeight: 1, fontWeight: 700 }}>01</span>\n                  <span style={{ fontFamily: FONT_BODY, fontSize: 20, lineHeight: 1.35, color: PALETTE.light, opacity: 0.94 }}>{c.bullets?.[0]}</span>\n                </li>\n                <li data-content-path=\"bullets.1\" style={{ listStyle: \"none\", padding: \"26px\", border: \"1px solid rgba(253,253,253,0.16)\", background: \"rgba(255,255,255,0.02)\", display: \"flex\", flexDirection: \"column\", gap: 16, textAlign: \"left\", boxSizing: \"border-box\", opacity: 0, animation: \"fadeRise 0.5s ease-out 1.8s forwards\" }}>\n                  <span style={{ fontFamily: FONT_DISPLAY, fontSize: 30, color: PALETTE.green, lineHeight: 1, fontWeight: 700 }}>02</span>\n                  <span style={{ fontFamily: FONT_BODY, fontSize: 20, lineHeight: 1.35, color: PALETTE.light, opacity: 0.94 }}>{c.bullets?.[1]}</span>\n                </li>\n                <li data-content-path=\"bullets.2\" style={{ listStyle: \"none\", padding: \"26px\", border: \"1px solid rgba(253,253,253,0.16)\", background: \"rgba(255,255,255,0.02)\", display: \"flex\", flexDirection: \"column\", gap: 16, textAlign: \"left\", boxSizing: \"border-box\", opacity: 0, animation: \"fadeRise 0.5s ease-out 2.2s forwards\" }}>\n                  <span style={{ fontFamily: FONT_DISPLAY, fontSize: 30, color: PALETTE.green, lineHeight: 1, fontWeight: 700 }}>03</span>\n                  <span style={{ fontFamily: FONT_BODY, fontSize: 20, lineHeight: 1.35, color: PALETTE.light, opacity: 0.94 }}>{c.bullets?.[2]}</span>\n                </li>\n              </ul>\n            ) : null}\n            <span data-content-path=\"caption\" style={{ fontFamily: FONT_SCRIPT, fontSize: 40, color: PALETTE.light, opacity: 0, [\"--to-op\" as any]: 0.9, letterSpacing: \"0.01em\", animation: \"fadeRiseTo 0.5s ease-out 3.6s forwards\" }}>{c.caption}</span>\n          </div>\n\n          <div style={{ width: \"100%\", maxWidth: 1560, borderTop: \"1px solid rgba(0,255,0,0.3)\", paddingTop: 16, display: \"flex\", justifyContent: \"space-between\", alignItems: \"center\", opacity: 0, animation: \"fadeRise 0.4s ease-out 4.0s forwards\" }}>\n            <span style={{ fontFamily: FONT_MONO, fontSize: 13, letterSpacing: \"0.2em\", textTransform: \"uppercase\", color: PALETTE.green, opacity: 0.85 }}>02 / 05</span>\n            <span style={{ fontFamily: FONT_MONO, fontSize: 13, letterSpacing: \"0.2em\", textTransform: \"uppercase\", color: PALETTE.light, opacity: 0.5 }}>ALUMINUM FOREVER</span>\n          </div>\n        </div>\n      </Piece>\n\n      <Piece id=\"s1.bottle\" kind=\"diegetic\">\n        <div style={{ position: \"absolute\", right: 96, bottom: 150, opacity: 0, animation: \"scaleInFrom60 0.6s cubic-bezier(.2,.8,.2,1) 1.2s forwards\" }}>\n          <ShatteredBottle width={300} fractureDelay={1.4} />\n        </div>\n      </Piece>\n\n      <Piece id=\"s1.chrome\" kind=\"chrome\"><Chrome sceneIndex={1} /></Piece>\n    </div>\n  );\n};"
 },
 {
  "id": "split-editor",
  "register": "split",
  "notes": "Asymmetric split: copy stack left, dense diegetic product mock right, footer meta row — no cross-piece collisions.",
  "code": "export const Section2: React.FC<{ script: Script }> = ({ script }) => {\n  const c = script.scenes[2].content;\n  return (\n    <div style={{ ...SECTION_FRAME, background: PALETTE.bg, fontFamily: FONT_BODY }}>\n      <style dangerouslySetInnerHTML={{ __html: BRAND_FONTS_CSS + KEYFRAMES_CSS }} />\n      <Piece id=\"s2.atmos\" kind=\"atmosphere\">\n        <div style={{ position: \"absolute\", left: \"50%\", top: \"50%\", width: 800, height: 800, marginTop: -400, marginLeft: -400, borderRadius: \"50%\", background: `radial-gradient(circle at 50% 50%, ${PALETTE.dark} 0%, transparent 60%)`, opacity: 0.05, filter: \"blur(40px)\", animation: \"glowBreathe 5s ease-in-out infinite\", pointerEvents: \"none\" }} />\n        <DustField opacity={0.5} />\n      </Piece>\n      <Piece id=\"s2.copy\" kind=\"text\">\n        <div style={{ position: \"absolute\", top: 90, left: 120, right: 120, display: \"flex\", flexDirection: \"column\", gap: 20 }}>\n          <Eyebrow text={c.eyebrow} style={{ opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 0s forwards\", animationDelay: \"0s\" }} />\n          <h1 data-content-path=\"headline\" style={{ fontFamily: FONT_DISPLAY, fontWeight: 700, fontSize: 72, lineHeight: 1.0, letterSpacing: \"-0.03em\", color: PALETTE.ink, margin: 0, opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 0.3s forwards\", animationDelay: \"0.3s\" }}>{c.headline}</h1>\n          <p data-content-path=\"lede\" style={{ fontFamily: FONT_BODY, fontSize: 24, lineHeight: 1.5, color: PALETTE.dark, [\"--fade-to\" as any]: \"0.85\", opacity: 0, margin: 0, maxWidth: 680, animation: \"fadeRiseTo 0.3s ease-out 0.5s forwards\", animationDelay: \"0.5s\" }}>{c.lede}</p>\n        </div>\n        {c.bullets?.length ? (\n          <ul style={{ position: \"absolute\", top: 720, left: 120, listStyle: \"none\", margin: 0, padding: 0, display: \"flex\", gap: 32, opacity: 0, animation: \"fadeRise 0.4s ease-out 4.5s forwards\", animationDelay: \"4.5s\" }}>\n            <li data-content-path=\"bullets.0\" style={{ display: \"flex\", alignItems: \"center\", gap: 10, fontFamily: FONT_BODY, fontSize: 18, color: PALETTE.dark }}>\n              <Check size={16} strokeWidth={2.25} color={PALETTE.ink} />\n              <span>{c.bullets[0]}</span>\n            </li>\n            <li data-content-path=\"bullets.1\" style={{ display: \"flex\", alignItems: \"center\", gap: 10, fontFamily: FONT_BODY, fontSize: 18, color: PALETTE.dark }}>\n              <Check size={16} strokeWidth={2.25} color={PALETTE.ink} />\n              <span>{c.bullets[1]}</span>\n            </li>\n            <li data-content-path=\"bullets.2\" style={{ display: \"flex\", alignItems: \"center\", gap: 10, fontFamily: FONT_BODY, fontSize: 18, color: PALETTE.dark }}>\n              <Check size={16} strokeWidth={2.25} color={PALETTE.ink} />\n              <span>{c.bullets[2]}</span>\n            </li>\n          </ul>\n        ) : null}\n        {c.caption && (\n          <div data-content-path=\"caption\" style={{ position: \"absolute\", top: 780, left: 120, fontFamily: FONT_MONO, fontSize: 13, letterSpacing: \"0.08em\", color: PALETTE.muted, display: \"inline-flex\", alignItems: \"center\", gap: 8, opacity: 0, animation: \"fadeRise 0.4s ease-out 5s forwards\", animationDelay: \"5s\" }}>\n            <span style={{ width: 6, height: 6, borderRadius: \"50%\", background: PALETTE.ink, display: \"inline-block\" }} />\n            {c.caption}\n          </div>\n        )}\n      </Piece>\n      <Piece id=\"s2.illustration\" kind=\"diegetic\">\n        <svg viewBox=\"0 0 200 120\" width={180} height={108} style={{ position: \"absolute\", top: 95, right: 120, opacity: 0, animation: \"fadeRise 0.4s ease-out 1s forwards\", animationDelay: \"1s\" }}>\n          <rect x=\"4\" y=\"4\" width=\"192\" height=\"112\" rx=\"10\" fill=\"none\" stroke={PALETTE.hairline} strokeWidth=\"1.5\" />\n          <line x1=\"4\" y1=\"28\" x2=\"196\" y2=\"28\" stroke={PALETTE.hairline} strokeWidth=\"1\" opacity=\"0.5\" />\n          <path d=\"M20 10 L78 10 Q82 10 82 14 L82 28 L16 28 L16 14 Q16 10 20 10 Z\" fill={PALETTE.hairline} opacity=\"0.15\" stroke={PALETTE.hairline} strokeWidth=\"1\" />\n          <circle cx=\"14\" cy=\"18\" r=\"3\" fill={PALETTE.muted} opacity=\"0.6\" />\n          <circle cx=\"24\" cy=\"18\" r=\"3\" fill={PALETTE.muted} opacity=\"0.5\" />\n          <circle cx=\"34\" cy=\"18\" r=\"3\" fill={PALETTE.muted} opacity=\"0.4\" />\n          <rect x=\"100\" y=\"14\" width=\"80\" height=\"8\" rx=\"4\" fill={PALETTE.hairline} opacity=\"0.3\" />\n          <rect x=\"20\" y=\"44\" width=\"120\" height=\"6\" rx=\"3\" fill={PALETTE.hairline} opacity=\"0.2\" />\n          <rect x=\"20\" y=\"58\" width=\"100\" height=\"6\" rx=\"3\" fill={PALETTE.hairline} opacity=\"0.15\" />\n          <rect x=\"20\" y=\"72\" width=\"80\" height=\"6\" rx=\"3\" fill={PALETTE.hairline} opacity=\"0.1\" />\n        </svg>\n      </Piece>\n      <Piece id=\"s2.editor\" kind=\"diegetic\">\n        <div style={{ position: \"absolute\", top: 340, left: 120, width: 780, opacity: 0, animation: \"slideInLeftScale 0.6s ease-out 0s forwards\", animationDelay: \"0s\" }}>\n          <BrowserTabEditor />\n        </div>\n      </Piece>\n      <Piece id=\"s2.playback\" kind=\"diegetic\">\n        <div style={{ position: \"absolute\", top: 320, left: 920, width: 820, height: 400, borderRadius: 24, background: `radial-gradient(circle at 50% 50%, ${PALETTE.dark} 0%, transparent 70%)`, opacity: 0, filter: \"blur(40px)\", animation: \"glowIntensify 1s ease-out 5.2s forwards\", animationDelay: \"5.2s\", pointerEvents: \"none\" }} />\n        <div style={{ position: \"absolute\", top: 340, left: 940, width: 780, opacity: 0, transform: \"translateX(30px)\", animation: \"slideInRight 0.6s ease-out 1.5s forwards\", animationDelay: \"1.5s\" }}>\n          <PlaybackCard />\n        </div>\n      </Piece>\n      <Piece id=\"s2.waveform\" kind=\"diegetic\" throughline=\"waveform\">\n        <div data-throughline=\"waveform\" style={{ position: \"absolute\", top: 650, left: \"50%\", transform: \"translateX(-50%)\", display: \"flex\", flexDirection: \"column\", alignItems: \"center\", gap: 16 }}>\n          <WaveformStrip barCount={50} amplitude={0.5} color={PALETTE.muted} width={1400} barWidth={3} opacity={0.3} height={50} />\n          <div style={{ width: 0, height: 1, background: PALETTE.hairline, opacity: 0, animation: \"accentExtendWide 0.8s ease-out 4.5s forwards\", animationDelay: \"4.5s\" }} />\n        </div>\n      </Piece>\n      <Piece id=\"s2.chrome\" kind=\"chrome\"><Chrome sceneIndex={2} totalScenes={5} category=\"AI Voice Platform\" /></Piece>\n    </div>\n  );\n};"
 },
 {
  "id": "list-grid",
  "register": "list",
  "notes": "A real list rendered as a labeled grid of pills + centered headline; fills the frame with structure.",
  "code": "export const Section3: React.FC<{ script: Script }> = ({ script }) => {\n  const c = script.scenes[3].content;\n  return (\n    <div style={{ ...SECTION_FRAME, background: PALETTE.bg, fontFamily: FONT_BODY }}>\n      <style dangerouslySetInnerHTML={{ __html: BRAND_FONTS_CSS + KEYFRAMES_CSS }} />\n      <Piece id=\"s3.atmos\" kind=\"atmosphere\">\n        <div style={{ position: \"absolute\", left: \"30%\", top: \"35%\", width: 700, height: 700, marginTop: -350, marginLeft: -350, borderRadius: \"50%\", background: `radial-gradient(circle at 50% 50%, ${PALETTE.dark} 0%, transparent 65%)`, opacity: 0.04, filter: \"blur(40px)\", animation: \"sphereDrift 7s ease-in-out infinite\", pointerEvents: \"none\" }} />\n        <div style={{ position: \"absolute\", right: \"20%\", top: \"60%\", width: 600, height: 600, marginTop: -300, marginRight: -300, borderRadius: \"50%\", background: `radial-gradient(circle at 50% 50%, ${PALETTE.dark} 0%, transparent 65%)`, opacity: 0.035, filter: \"blur(40px)\", animation: \"sphereDrift 9s ease-in-out infinite reverse\", pointerEvents: \"none\" }} />\n        <DustField opacity={0.5} />\n      </Piece>\n      <Piece id=\"s3.languages\" kind=\"diegetic\">\n        <div style={{ position: \"absolute\", top: 100, left: \"50%\", transform: \"translateX(-50%)\", display: \"flex\", gap: 12, flexWrap: \"nowrap\", animation: \"pillRowDrift 20s ease-in-out 2.5s infinite\" }}>\n          {LANGUAGES.map((lang, i) => (\n            <Piece key={i} id={`s3.languages.${i}`} kind=\"card\">\n              <LanguagePill name={lang.name} flagUrl={lang.flagUrl} featured={i === 0} style={{ opacity: 0, animation: `slideInLeftFade 0.5s ease-out ${0.3 + i * 0.1}s forwards, pillBorderGlow 3s ease-in-out ${2.5 + i * 0.3}s infinite`, animationDelay: `${0.3 + i * 0.1}s` }} />\n            </Piece>\n          ))}\n        </div>\n      </Piece>\n      <Piece id=\"s3.copy\" kind=\"text\">\n        <div style={{ position: \"absolute\", top: 200, left: \"50%\", transform: \"translateX(-50%)\", width: 1200, display: \"flex\", flexDirection: \"column\", alignItems: \"center\", textAlign: \"center\", gap: 24 }}>\n          <Eyebrow text={c.eyebrow} align=\"center\" style={{ opacity: 0, animation: \"fadeRise 0.4s ease-out 0.2s forwards\", animationDelay: \"0.2s\" }} />\n          <h1 data-content-path=\"headline\" style={{ fontFamily: FONT_DISPLAY, fontWeight: 700, fontSize: 84, lineHeight: 1.02, letterSpacing: \"-0.03em\", color: PALETTE.ink, margin: 0, maxWidth: 1100, opacity: 0, animation: \"fadeRise 0.4s ease-out 0.5s forwards\", animationDelay: \"0.5s\" }}>{c.headline}</h1>\n          <p data-content-path=\"lede\" style={{ fontFamily: FONT_BODY, fontSize: 24, lineHeight: 1.5, color: PALETTE.dark, [\"--fade-to\" as any]: \"0.85\", opacity: 0, margin: 0, maxWidth: 720, animation: \"fadeRiseTo 0.3s ease-out 0.7s forwards\", animationDelay: \"0.7s\" }}>{c.lede}</p>\n        </div>\n        {c.bullets?.length ? (\n          <ul style={{ position: \"absolute\", top: 540, left: \"50%\", transform: \"translateX(-50%)\", listStyle: \"none\", margin: 0, padding: 0, display: \"flex\", gap: 36, opacity: 0, animation: \"fadeIn 0.5s ease-out 2.5s forwards\", animationDelay: \"2.5s\" }}>\n            <li data-content-path=\"bullets.0\" style={{ display: \"flex\", alignItems: \"center\", gap: 10, fontFamily: FONT_BODY, fontSize: 18, color: PALETTE.dark, whiteSpace: \"nowrap\" }}>\n              <Check size={16} strokeWidth={2.25} color={PALETTE.ink} />\n              <span>{c.bullets[0]}</span>\n            </li>\n            <li data-content-path=\"bullets.1\" style={{ display: \"flex\", alignItems: \"center\", gap: 10, fontFamily: FONT_BODY, fontSize: 18, color: PALETTE.dark, whiteSpace: \"nowrap\" }}>\n              <Check size={16} strokeWidth={2.25} color={PALETTE.ink} />\n              <span>{c.bullets[1]}</span>\n            </li>\n            <li data-content-path=\"bullets.2\" style={{ display: \"flex\", alignItems: \"center\", gap: 10, fontFamily: FONT_BODY, fontSize: 18, color: PALETTE.dark, whiteSpace: \"nowrap\" }}>\n              <Check size={16} strokeWidth={2.25} color={PALETTE.ink} />\n              <span>{c.bullets[2]}</span>\n            </li>\n          </ul>\n        ) : null}\n        {c.caption && (\n          <div data-content-path=\"caption\" style={{ position: \"absolute\", bottom: 80, left: \"50%\", transform: \"translateX(-50%)\", fontFamily: FONT_MONO, fontSize: 13, letterSpacing: \"0.06em\", color: PALETTE.muted, textAlign: \"center\", maxWidth: 800, opacity: 0, animation: \"fadeIn 0.4s ease-out 3.5s forwards\", animationDelay: \"3.5s\" }}>{c.caption}</div>\n        )}\n      </Piece>\n      <Piece id=\"s3.waveform\" kind=\"diegetic\" throughline=\"waveform\">\n        <div data-throughline=\"waveform\" style={{ position: \"absolute\", left: \"50%\", top: 610, transform: \"translateX(-50%)\" }}>\n          <WaveformStrip barCount={60} amplitude={0.5} color={PALETTE.muted} width={1600} barWidth={3} opacity={0.35} height={70} />\n        </div>\n      </Piece>\n      <Piece id=\"s3.trust\" kind=\"diegetic\">\n        <div style={{ position: \"absolute\", top: 720, left: \"50%\", transform: \"translateX(-50%)\", display: \"flex\", flexDirection: \"column\", alignItems: \"center\", gap: 20 }}>\n          <div style={{ fontFamily: FONT_BODY, fontSize: 14, fontWeight: 300, color: PALETTE.muted, letterSpacing: \"0.02em\", opacity: 0, animation: \"fadeIn 0.5s ease-out 3s forwards\", animationDelay: \"3s\" }}>Trusted by leading developers and enterprises</div>\n          <div style={{ display: \"flex\", alignItems: \"center\", gap: 56 }}>\n            <div style={{ opacity: 0, animation: \"fadeIn 0.4s ease-out 3.8s forwards\", animationDelay: \"3.8s\" }}>\n              <Piece id=\"s3.trust.0\" kind=\"card\"><Img src={PARTNER_NVIDIA} style={{ height: 28, filter: \"grayscale(1)\", opacity: 0.5 }} /></Piece>\n            </div>\n            <div style={{ opacity: 0, animation: \"fadeIn 0.4s ease-out 4s forwards\", animationDelay: \"4s\" }}>\n              <Piece id=\"s3.trust.1\" kind=\"card\"><Img src={PARTNER_DUOLINGO} style={{ height: 28, filter: \"grayscale(1)\", opacity: 0.5 }} /></Piece>\n            </div>\n            <div style={{ opacity: 0, animation: \"fadeIn 0.4s ease-out 4.2s forwards\", animationDelay: \"4.2s\" }}>\n              <Piece id=\"s3.trust.2\" kind=\"card\"><Img src={PARTNER_CLAY} style={{ height: 28, filter: \"grayscale(1)\", opacity: 0.5 }} /></Piece>\n            </div>\n            <div style={{ opacity: 0, animation: \"fadeIn 0.4s ease-out 4.4s forwards\", animationDelay: \"4.4s\" }}>\n              <Piece id=\"s3.trust.3\" kind=\"card\"><span style={{ fontFamily: FONT_BODY, fontSize: 20, fontWeight: 300, color: PALETTE.muted, letterSpacing: \"0.02em\" }}>Epic Games</span></Piece>\n            </div>\n          </div>\n        </div>\n      </Piece>\n      <Piece id=\"s3.chrome\" kind=\"chrome\"><Chrome sceneIndex={3} totalScenes={5} category=\"AI Voice Platform\" /></Piece>\n    </div>\n  );\n};"
 },
