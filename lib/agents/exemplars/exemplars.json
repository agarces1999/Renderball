  "code": "export const Section0: React.FC<{ script: Script }> = ({ script }) => {\n  const c = script.scenes[0].content;\n  return (\n    <div style={{ ...SECTION_FRAME, background: PALETTE.black, fontFamily: FONT_BODY, color: PALETTE.light }}>\n      <style dangerouslySetInnerHTML={{ __html: BRAND_FONTS_CSS + ANIMATIONS_CSS }} />\n      <style dangerouslySetInnerHTML={{ __html: `\n        @keyframes s0AccentLateGlow { from { box-shadow: 0 0 20px rgba(0,255,0,0.75); } to { box-shadow: 0 0 40px rgba(0,255,0,1); } }\n        @keyframes s0RingsLateScale { 0% { transform: translate(-50%,-50%) scale(1); } 100% { transform: translate(-50%,-50%) scale(1.06); } }\n      `}} />\n\n      <Piece id=\"s0.atmos\" kind=\"atmosphere\">\n        <div style={{ position: \"absolute\", inset: 0, background: \"radial-gradient(circle at 50% 42%, rgba(0,255,0,0.18) 0%, rgba(0,255,0,0.05) 32%, transparent 64%)\", animation: \"breatheGlowS0 2.5s ease-in-out infinite\" }} />\n        <div style={{ position: \"absolute\", left: \"50%\", top: \"42%\", transform: \"translate(-50%,-50%)\", opacity: 0, [\"--to-op\" as any]: 0.5, animation: \"fadeInTo 0.8s ease-out 0.2s forwards, s0RingsLateScale 1s ease-out 3.0s forwards\" }}>\n          <ConcentricRings size={760} opacity={0.22} />\n        </div>\n        {[\n          { x: 15, y: 28, s: 7 },\n          { x: 83, y: 22, s: 5 },\n          { x: 23, y: 78, s: 6 },\n        ].map((d, i) => (\n          <div key={i} style={{ position: \"absolute\", left: `${d.x}%`, top: `${d.y}%`, width: d.s, height: d.s, borderRadius: \"50%\", background: PALETTE.red, boxShadow: \"0 0 18px rgba(255,0,0,0.75)\", [\"--dot-op\" as any]: 0.82, opacity: 0, animation: `dotEnter 0.4s ease-out ${1.2 + i * 0.4}s forwards, drift${(i % 3) + 1} ${4 + i}s ease-in-out 0s infinite` }} />\n        ))}\n        <GrainOverlay opacity={0.06} />\n      </Piece>\n\n      <Piece id=\"s0.throughline\" kind=\"diegetic\" throughline=\"tallboy-can\">\n        <div data-throughline=\"tallboy-can\" style={{ position: \"absolute\", left: THL.left, top: THL.top, opacity: 0, [\"--to-op\" as any]: 0.08, animation: \"fadeInTo 1s ease-out 2.2s forwards\" }}>\n          <TallboyCan variant=\"silhouette\" width={150} gid=\"s0\" />\n        </div>\n      </Piece>\n\n      <Piece id=\"s0.copy\" kind=\"text\">\n        <div style={{ position: \"absolute\", left: 80, top: 80, width: 1760, height: 920, display: \"flex\", flexDirection: \"column\", alignItems: \"center\", justifyContent: \"space-between\", textAlign: \"center\", boxSizing: \"border-box\", padding: \"40px 0\" }}>\n          <div style={{ display: \"flex\", flexDirection: \"column\", alignItems: \"center\", gap: 22 }}>\n            <div style={{ ...eyebrowStyle, opacity: 0, animation: \"fadeRise 0.4s cubic-bezier(.2,.8,.2,1) 0s forwards\" }}>\n              <span style={{ width: 30, height: 1, background: PALETTE.green, opacity: 0.7, display: \"inline-block\" }} />\n              <span data-content-path=\"eyebrow\">{c.eyebrow}</span>\n            </div>\n            <Img src={LOGO_SRC} style={{ width: 420, height: \"auto\", filter: \"invert(1) brightness(1.15)\", opacity: 0, animation: \"scaleInSpring 0.8s cubic-bezier(.2,.9,.2,1) 0s forwards\" }} />\n            <div style={{ width: 0, height: 3, background: PALETTE.green, boxShadow: \"0 0 20px rgba(0,255,0,0.75)\", [\"--tw\" as any]: \"180px\", animation: \"drawWidthPx 0.5s ease-out 1.0s forwards, s0AccentLateGlow 0.8s ease-out 3.2s forwards\" }} />\n          </div>\n\n          <div style={{ display: \"flex\", flexDirection: \"column\", alignItems: \"center\", gap: 26 }}>\n            <h1 data-content-path=\"headline\" style={{ ...headlineBase, fontSize: 128, lineHeight: 0.95, maxWidth: 1560, textTransform: \"uppercase\", opacity: 0, animation: \"letterSettle 0.5s cubic-bezier(.2,.8,.2,1) 0.4s forwards\" }}>{c.headline}</h1>\n            <p data-content-path=\"lede\" style={{ ...ledeStyle, maxWidth: 840, textAlign: \"center\", opacity: 0, [\"--to-op\" as any]: 0.86, animation: \"fadeRiseTo 0.5s cubic-bezier(.2,.8,.2,1) 0.3s forwards\" }}>{c.lede}</p>\n            <span data-content-path=\"caption\" style={{ ...chromeCaption, opacity: 0, [\"--to-op\" as any]: 0.5, animation: \"fadeRiseTo 0.4s ease-out 1.4s forwards\" }}>{c.caption}</span>\n          </div>\n\n          <div style={{ width: \"100%\", maxWidth: 1200, opacity: 0, animation: \"fadeRise 0.5s ease-out 2.8s forwards\" }}>\n            <MetaFooter items={c.meta} />\n          </div>\n        </div>\n      </Piece>\n\n      <Piece id=\"s0.chrome\" kind=\"chrome\"><Chrome sceneIndex={0} showCornerLogo={false} /></Piece>\n    </div>\n  );\n};"
 }
