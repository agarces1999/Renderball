# Renderball — environment template.
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Grouped by the account/service you need to create. "[have]" = already set today.
# Decisions locked 2026-06-17: Clerk auth · Stripe subscription+free tier first · Remotion Lambda render.

# ─────────────────────────────────────────────────────────────────────────────
# 1. App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # prod: https://renderball.com

# ─────────────────────────────────────────────────────────────────────────────
# 2. Anthropic + Pexels  [have — keep existing values]
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
PEXELS_API_KEY=                              # optional; stock photo search degrades silently if unset

# ─────────────────────────────────────────────────────────────────────────────
# 3. Auth — Clerk   (dashboard.clerk.com → create app → enable Google + Email)
#    Enable the Google social connection in Clerk; no separate Google Cloud
#    OAuth app needed for launch (Clerk brokers it). Add your own Google
#    OAuth credentials later to drop Clerk's "development" consent screen.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=               # Clerk → Webhooks → user.created/updated/deleted → syncs users into our DB

# ─────────────────────────────────────────────────────────────────────────────
# 4. Database — Postgres   (Neon or Supabase; free tier fine to start)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=                               # postgresql://user:pass@host/db?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# 5. Payments — Stripe   (dashboard.stripe.com — START IN TEST MODE)
#    Create one recurring Product: "$29.99/mo" → copy its price id below.
#    Webhook endpoint: <APP_URL>/api/webhooks/stripe (events: checkout.session.completed,
#    customer.subscription.updated/deleted, invoice.payment_failed, charge.dispute.created).
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                          # sk_test_... then sk_live_... at GA
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=         # pk_test_...
STRIPE_WEBHOOK_SECRET=                      # whsec_... from the webhook endpoint
STRIPE_PRICE_SUBSCRIPTION=                  # price_... for the $29.99/mo plan

# ─────────────────────────────────────────────────────────────────────────────
# 6. Render — Remotion Lambda + AWS   (the single biggest infra lift)
#    npx remotion lambda functions deploy  →  fills the function name + serve url.
#    IAM user needs the Remotion Lambda policy (lambda, s3, cloudwatch).
# ─────────────────────────────────────────────────────────────────────────────
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
REMOTION_LAMBDA_FUNCTION_NAME=              # set after `remotion lambda functions deploy`
REMOTION_SERVE_URL=                         # set after `remotion lambda sites create`

# ─────────────────────────────────────────────────────────────────────────────
# 7. Object storage — Cloudflare R2 or AWS S3   (renders, uploads, generated code)
#    R2 recommended: zero egress fees for video. Bucket + API token.
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=                           # R2: https://<acct>.r2.cloudflarestorage.com ; S3: leave blank
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=                    # CDN/public base for serving e.g. https://cdn.renderball.com

# ─────────────────────────────────────────────────────────────────────────────
# 8. Transactional email — Resend   (receipts, payment-failed, takedown notices)
#    Needs a verified sending domain (DNS records).
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Renderball <noreply@renderball.com>

# ─────────────────────────────────────────────────────────────────────────────
# 9. Rate limiting — Upstash Redis   (cost-runaway protection on expensive routes)
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 10. Observability — Sentry + PostHog   (errors + signup→render→pay funnel)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                          # for source-map upload at build
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
