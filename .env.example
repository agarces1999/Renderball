# Renderball — environment template.
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Grouped by the account/service you need to create. "[have]" = already set today.
# Decisions locked 2026-06-17 (amended 2026-07-10): Clerk auth · Stripe
# subscription+free tier first · in-container render (Lambda deferred to scale-out).

# ─────────────────────────────────────────────────────────────────────────────
# 1. App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # prod: https://renderball.com

# ─────────────────────────────────────────────────────────────────────────────
# 2. Anthropic + Pexels  [have — keep existing values]
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                          # REQUIRED — https://api.z.ai/api/anthropic (z.ai compat endpoint).
                                             # Production BOOT-ASSERTS this (lib/anthropic.ts): unset = the app
                                             # refuses to start rather than silently billing the wrong provider.
PEXELS_API_KEY=                              # optional; stock photo search degrades silently if unset

# ─────────────────────────────────────────────────────────────────────────────
# 3. Auth — Clerk   (dashboard.clerk.com → create app → enable Google + Email)
#    Enable the Google social connection in Clerk; no separate Google Cloud
#    OAuth app needed for launch (Clerk brokers it). Add your own Google
#    OAuth credentials later to drop Clerk's "development" consent screen.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=               # Clerk → Webhooks → user.created/updated/deleted → syncs users into our DB
# In-app (branded) auth pages — see app/sign-in, app/sign-up:
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/videos
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/videos

# ─────────────────────────────────────────────────────────────────────────────
# 4. Database — Postgres   (Neon or Supabase; free tier fine to start)
# ─────────────────────────────────────────────────────────────────────────────
# Include connect_timeout — Neon's scale-to-zero compute takes seconds to wake
# after idle, and Prisma's 5s default loses that race (observed live: 41–70s of
# retries then a raw 500 on the first request after 2 idle days).
DATABASE_URL=                               # postgresql://user:pass@host/db?sslmode=require&connect_timeout=15&pool_timeout=15

# ─────────────────────────────────────────────────────────────────────────────
# 5. Payments — Lemon Squeezy   (app.lemonsqueezy.com — THE LIVE PROCESSOR)
#
#    Stripe does not operate in Colombia; Lemon Squeezy is a merchant of record
#    and pays out here. Setup, in order:
#      1. Create a store → Settings → API → new API key.
#      2. New Product → Subscription → pricing model of your choice, and turn ON
#         "Usage is metered". Metered checkouts charge $0 up front and bill in
#         arrears on the usage we report — that IS the 1M-free-then-metered
#         model in docs/PIVOT.md.
#      3. Copy the VARIANT id (not the product id) into LEMONSQUEEZY_VARIANT_TOKENS.
#      4. Settings → Webhooks → <APP_URL>/api/webhooks/lemonsqueezy, signing
#         secret below, events: subscription_created, subscription_updated,
#         subscription_cancelled, subscription_expired, subscription_paused,
#         subscription_unpaused, subscription_resumed.
#
#    Setting all four flips checkout, the portal, the webhook and metered usage
#    reporting live with zero code changes.
# ─────────────────────────────────────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=                       # Settings → API
LEMONSQUEEZY_WEBHOOK_SECRET=                # the signing secret on the webhook
LEMONSQUEEZY_STORE_ID=                      # numeric store id
LEMONSQUEEZY_VARIANT_TOKENS=                # numeric VARIANT id of the metered plan
# RB_METER_UNIT_TOKENS=1000                 # set to 1000 if the price form refuses $0.00001/token:
#                                           #   price the unit per 1,000 tokens instead and this
#                                           #   converts. Partial units carry over, never round away.
#                                           #   Getting this wrong is a 1000x invoice — docs/METERING.md.

# ─────────────────────────────────────────────────────────────────────────────
# 5b. Payments — Stripe   [DORMANT. Only usable with an entity in a supported
#     country; kept because the fees are lower if one ever exists. Lemon Squeezy
#     wins whenever both are configured — see lib/billing-provider.ts.]
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                          # sk_test_... then sk_live_... at GA
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=         # pk_test_...
STRIPE_WEBHOOK_SECRET=                      # whsec_... from the webhook endpoint
STRIPE_PRICE_SUBSCRIPTION=                  # price_... for the $49.99/mo plan
STRIPE_PRICE_TOKENS=                        # price_... metered per-token price (scripts/stripe-setup-meter.mjs; docs/METERING.md)

# ─────────────────────────────────────────────────────────────────────────────
# 6. Render — Remotion Lambda + AWS   [NOT NEEDED FOR LAUNCH — container render
#    decision 2026-07-10; keep unset. Lambda is the deferred scale-out path.]
# ─────────────────────────────────────────────────────────────────────────────
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
REMOTION_LAMBDA_FUNCTION_NAME=              # set after `remotion lambda functions deploy`
REMOTION_SERVE_URL=                         # set after `remotion lambda sites create`

# ─────────────────────────────────────────────────────────────────────────────
# 7. Object storage — Cloudflare R2 or AWS S3   (renders, uploads, generated code)
#    R2 recommended: zero egress fees for video. Bucket + API token.
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=                           # R2: https://<acct>.r2.cloudflarestorage.com ; S3: leave blank
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=                    # CDN/public base for serving e.g. https://cdn.renderball.com

# ─────────────────────────────────────────────────────────────────────────────
# 8. Transactional email — Resend   (receipts, payment-failed, takedown notices)
#    Needs a verified sending domain (DNS records).
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Renderball <noreply@renderball.com>

# ─────────────────────────────────────────────────────────────────────────────
# 9. Rate limiting — Upstash Redis   (cost-runaway protection on expensive routes)
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 10. Observability — Sentry + PostHog   (errors + signup→render→pay funnel)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                          # for source-map upload at build
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────────────────────────────────────────
# 10b. Alerting — where you find out production broke
#
#    What fires: the spend breaker opening (CRITICAL — every build, generate and
#    regenerate in the product is failing) and closing again. Unset, alerts
#    degrade to console lines, which is how a total outage would go unnoticed.
#
#    EMAIL is the default channel. Two values for Gmail: your address and an App
#    Password (https://myaccount.google.com/apppasswords — needs 2-Step
#    Verification on, and is NOT your account password). Paste both verbatim;
#    the spaces Google shows are stripped for you.
#
#    SMTP under the hood rather than a vendor SDK, so moving to Resend, Postmark
#    or SES later is one SMTP_URL instead of a rewrite.
#
#    Test it before you trust it:  npm run alert:test
#
#    The pull-side companion is GET /api/health — point an uptime monitor at it
#    (503 when the database is unreachable or generation is down).
# ─────────────────────────────────────────────────────────────────────────────
# GMAIL_USER=                               # your address — alerts are sent from and to it
# GMAIL_APP_PASSWORD=                       # the 16-char code from https://myaccount.google.com/apppasswords
#
# Anything other than Gmail, or a different recipient:
# SMTP_URL=                                 # e.g. smtps://resend:re_key@smtp.resend.com:465
# RB_ALERT_EMAIL=                           # send somewhere other than GMAIL_USER
# RB_ALERT_WEBHOOK=                         # optional second channel — Slack or Discord webhook URL

# ─────────────────────────────────────────────────────────────────────────────
# 10c. QA — the signed-in half of the browser suite
#
#    `npm run qa` runs the public and dev-harness flows with no setup. The
#    signed-in flows (document list, create/delete, export, share round trip,
#    billing and account pages, cross-tenant ownership) need a real account and
#    SKIP with a reason when these are unset — they never fail the run.
#
#    Make one throwaway user in the Clerk DEV instance. Clerk test addresses of
#    the form you+clerk_test@example.com verify with the fixed code 424242, so
#    no inbox is involved. Costs nothing to run: every signed-in flow is
#    deterministic and spends no tokens.
# ─────────────────────────────────────────────────────────────────────────────
# QA_TEST_EMAIL=
# QA_TEST_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# 11. Tunables (safe defaults — set only to override)
# ─────────────────────────────────────────────────────────────────────────────
# RB_STORE_BACKEND=pg                       # pg (default) | file — brief/script persistence
# RB_METERING=off                           # off (default) | count (shadow-count only) | on (gate + report usage) — docs/METERING.md
# RB_FREE_TOKENS=1000000                    # lifetime free token allowance
# STRIPE_TOKEN_METER_EVENT=renderball_tokens # meter event_name — set only to override
# FREE_GENERATES_PER_MONTH=3                # entitlement limits (lib/entitlement.ts)
# FREE_BUILDS_PER_MONTH=1
# SUB_GENERATES_PER_MONTH=60
# SUB_BUILDS_PER_MONTH=30
# RB_VISION_LOOP=1                          # 0 disables the vision QA loop
# RB_EXEMPLARS=1                            # 0 disables golden-scene exemplars
# RB_STREAM_CEILING_MIN=75                  # build-stream stall ceiling (minutes)
