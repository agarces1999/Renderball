+/** Leading hue FAMILY's share of all chromatic colour occurrences. */
+export const chromaticInkShare = (
+  css: string,
+): { share: number; leader: string | null; leaderCount: number; total: number } => {
+  const chromatic = Array.from(countColorLiterals(css))
+    .filter(([hex]) => isChromatic(hex))
+    .sort((a, b) => b[1] - a[1]);
+  const total = chromatic.reduce((s, [, n]) => s + n, 0);
+  if (total === 0 || !chromatic[0]) {
+    return { share: 0, leader: null, leaderCount: 0, total: 0 };
+  }
+  const leader = chromatic[0][0];
+  const family = chromatic
+    .filter(([hex]) => rgbDistance(hex, leader) < 90)
+    .reduce((s, [, n]) => s + n, 0);
+  return { share: family / total, leader, leaderCount: family, total };
+};
